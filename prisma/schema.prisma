  intakeScope          String
  recoveryStatus       String                 @default("PENDING")
  backupArtifactSha256 String?
  backupKeyVersion     String?
  backupVerifiedAt     DateTime?
  retentionReviewAt    DateTime
  createdByUserId      String?
  createdAt            DateTime               @default(now())

  @@index([requestId, visibility, createdAt])
  @@index([messageId])
  @@index([sha256])
}

model SupportAssignment {
