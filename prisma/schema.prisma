model MiscIncomeRate {
  id            String                  @id @default(cuid())
  itemId        String
  item          MiscIncomeItem          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  academicYear  String
  amount        Decimal
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  notes         String?
  status        String                  @default("ACTIVE")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  receiptLines  MiscIncomeReceiptLine[]

  @@index([itemId, academicYear, status])
  @@index([academicYear])
}

model MiscIncomeReceipt {
  id                   String                  @id @default(cuid())
  receiptNumber        String                  @unique
  receiptDate          DateTime
  academicYear         String
  studentId            String?
  student              Student?                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payerName            String?
  paymentMethod        String
  receivedAccount      String?
  transactionReference String?
  chequeNumber         String?
  chequeDate           DateTime?
  grossAmount          Decimal
  discountAmount       Decimal                 @default(0)
  netAmount            Decimal
  status               String                  @default("ACTIVE")
  remarks              String?
  createdByUserId      String?
  createdBy            User?                   @relation("MiscIncomeReceiptCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledByUserId    String?
  cancelledBy          User?                   @relation("MiscIncomeReceiptCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  lines                MiscIncomeReceiptLine[]
