  @@index([academicYear])
  @@index([studentId])
  @@index([paymentMethod])
  @@index([receivedAccount])
  @@index([status])
}

model MiscIncomeReceiptLine {
  id               String            @id @default(cuid())
  receiptId        String
  receipt          MiscIncomeReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  itemId           String
  item             MiscIncomeItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemNameSnapshot String
  rateId           String?
  rate             MiscIncomeRate?   @relation(fields: [rateId], references: [id], onDelete: Restrict)
  quantity         Int
  unitAmount       Decimal
  discountAmount   Decimal           @default(0)
  lineTotal        Decimal
  notes            String?
  createdAt        DateTime          @default(now())

  @@index([receiptId])
  @@index([itemId])
  @@index([rateId])
}

model CashBookDay {
