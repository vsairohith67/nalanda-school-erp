  reason              String
  previousTotalAmount Decimal
  revisedTotalAmount  Decimal
  revisionData        String
  status              String     @default("DRAFT")
  createdByUserId     String?
  createdBy           User?      @relation("BudgetRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submittedByUserId   String?
  submittedBy         User?      @relation("BudgetRevisionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId    String?
  approvedBy          User?      @relation("BudgetRevisionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  submittedAt         DateTime?
  approvedAt          DateTime?
  rejectionReason     String?
  cancellationReason  String?
  createdAt           DateTime   @default(now())

