  @@index([academicYear])
  @@index([status])
}

model CashBookMovement {
  id                 String              @id @default(cuid())
  cashBookDayId      String
  cashBookDay        CashBookDay         @relation(fields: [cashBookDayId], references: [id], onDelete: Restrict)
  movementType       String
  amount             Decimal
  movementDate       DateTime
  referenceNumber    String?
  bankName           String?
  recipientName      String?
  reason             String
  notes              String?
  status             String              @default("ACTIVE")
  recordedByUserId   String?
  recordedBy         User?               @relation("CashBookMovementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  cancelledByUserId  String?
  cancelledBy        User?               @relation("CashBookMovementCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bookCashSettlement BookCashSettlement?

  @@index([cashBookDayId, status])
  @@index([movementDate])
  @@index([movementType])
}

model LibraryTitle {
  id                        String                            @id @default(cuid())
  titleCode                 String                            @unique
  title                     String
  subtitle                  String?
  authors                   String
  isbn                      String?                           @unique
  edition                   String?
  publisherName             String?
  publisherVendorId         String?
  publisherVendor           Vendor?                           @relation(fields: [publisherVendorId], references: [id], onDelete: Restrict)
  publicationYear           Int?
  language                  String?
  subject                   String?
  category                  String?
  classificationNumber      String?
  defaultShelfCode          String?
  description               String?
  status                    String                            @default("ACTIVE")
  createdByUserId           String?
  createdBy                 User?                             @relation("LibraryTitleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  copies                    LibraryCopy[]
  reservations              LibraryReservation[]
  loanEvents                LibraryLoanEvent[]
  incidents                 LibraryIncident[]
  stockVerificationSessions LibraryStockVerificationSession[]

  @@index([title])
  @@index([authors])
  @@index([publisherVendorId])
  @@index([status, language])
  @@index([subject, category])
}

model LibraryCopy {
  id                       String                           @id @default(cuid())
  titleId                  String
  title                    LibraryTitle                     @relation(fields: [titleId], references: [id], onDelete: Restrict)
  accessionNumber          String                           @unique
  barcodeValue             String?                          @unique
  acquisitionDate          DateTime?
  acquisitionType          String                           @default("OTHER")
  acquisitionCost          Decimal?
  vendorId                 String?
  vendor                   Vendor?                          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  expenseRecordId          String?
  expenseRecord            ExpenseRecord?                   @relation(fields: [expenseRecordId], references: [id], onDelete: Restrict)
  donorName                String?
  invoiceNumberSnapshot    String?
  condition                String                           @default("GOOD")
  status                   String                           @default("AVAILABLE")
  shelfCode                String?
  notes                    String?
  withdrawnDate            DateTime?
  withdrawalReason         String?
  createdByUserId          String?
  createdBy                User?                            @relation("LibraryCopyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId          String?
  updatedBy                User?                            @relation("LibraryCopyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  events                   LibraryCopyEvent[]
  loans                    LibraryLoan[]
  loanEvents               LibraryLoanEvent[]
  incidents                LibraryIncident[]                @relation("LibraryIncidentCopy")
  replacementIncidents     LibraryIncident[]                @relation("LibraryIncidentReplacementCopy")
  stockVerificationRecords LibraryStockVerificationRecord[]

  @@index([titleId, status])
  @@index([condition])
  @@index([shelfCode])
  @@index([vendorId])
  @@index([expenseRecordId])
  @@index([acquisitionType])
}

model LibraryCopyEvent {
  id                    String                          @id @default(cuid())
  copyId                String
  copy                  LibraryCopy                     @relation(fields: [copyId], references: [id], onDelete: Restrict)
  eventType             String
  eventDate             DateTime
  previousStatus        String?
  newStatus             String?
  previousCondition     String?
  newCondition          String?
  previousShelfCode     String?
  newShelfCode          String?
  reason                String?
  notes                 String?
  recordedByUserId      String?
  recordedBy            User?                           @relation("LibraryCopyEventRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  stockResolutionRecord LibraryStockVerificationRecord? @relation("LibraryStockAppliedCopyEvent")
  createdAt             DateTime                        @default(now())

  @@index([copyId, eventDate])
  @@index([eventType])
  @@index([recordedByUserId])
}

model LibraryStockVerificationSession {
  id                 String                              @id @default(cuid())
  sessionNumber      String                              @unique
  title              String
  academicYear       String
  verificationDate   DateTime
  scopeType          String
  shelfCodeFilter    String?
  titleIdFilter      String?
  titleFilter        LibraryTitle?                       @relation(fields: [titleIdFilter], references: [id], onDelete: Restrict)
  categoryFilter     String?
  subjectFilter      String?
  status             String                              @default("DRAFT")
  expectedCopyCount  Int                                 @default(0)
  verifiedCopyCount  Int                                 @default(0)
  presentCount       Int                                 @default(0)
  issuedOffsiteCount Int                                 @default(0)
  knownRepairCount   Int                                 @default(0)
  missingCount       Int                                 @default(0)
  misShelvedCount    Int                                 @default(0)
  damagedCount       Int                                 @default(0)
  unexpectedCount    Int                                 @default(0)
  unresolvedCount    Int                                 @default(0)
  notes              String?
  cancellationReason String?
  createdByUserId    String?
  createdBy          User?                               @relation("LibraryStockSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  startedByUserId    String?
  startedBy          User?                               @relation("LibraryStockSessionStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  submittedByUserId  String?
  submittedBy        User?                               @relation("LibraryStockSessionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId   String?
  reviewedBy         User?                               @relation("LibraryStockSessionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId   String?
  approvedBy         User?                               @relation("LibraryStockSessionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lockedByUserId     String?
  lockedBy           User?                               @relation("LibraryStockSessionLockedBy", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  cancelledByUserId  String?
  cancelledBy        User?                               @relation("LibraryStockSessionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  startedAt          DateTime?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  lockedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  records            LibraryStockVerificationRecord[]
  scanEvents         LibraryStockVerificationScanEvent[]
  events             LibraryStockVerificationEvent[]

  @@index([academicYear, status])
  @@index([verificationDate])
  @@index([scopeType])
}

model LibraryStockVerificationRecord {
  id                              String                              @id @default(cuid())
  sessionId                       String
  session                         LibraryStockVerificationSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  copyId                          String
  copy                            LibraryCopy                         @relation(fields: [copyId], references: [id], onDelete: Restrict)
  expectedAccessionNumberSnapshot String
  expectedBarcodeSnapshot         String?
  expectedTitleSnapshot           String
  expectedShelfCodeSnapshot       String?
  expectedStatusSnapshot          String
  expectedConditionSnapshot       String
  expectedLoanStatusSnapshot      String?
  expectedBorrowerTypeSnapshot    String?
  expectedDueDateSnapshot         DateTime?
  observationStatus               String                              @default("NOT_CHECKED")
  observedAt                      DateTime?
  observedShelfCode               String?
  observedCondition               String?
  scanMethod                      String?
  observationNotes                String?
  discrepancyReason               String?
  resolutionStatus                String                              @default("NOT_REQUIRED")
  resolutionNotes                 String?
  appliedCopyEventId              String?                             @unique
  appliedCopyEvent                LibraryCopyEvent?                   @relation("LibraryStockAppliedCopyEvent", fields: [appliedCopyEventId], references: [id], onDelete: Restrict)
  observedByUserId                String?
  observedBy                      User?                               @relation("LibraryStockRecordObservedBy", fields: [observedByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId                String?
  reviewedBy                      User?                               @relation("LibraryStockRecordReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  appliedByUserId                 String?
  appliedBy                       User?                               @relation("LibraryStockRecordAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  createdAt                       DateTime                            @default(now())
  updatedAt                       DateTime                            @updatedAt
  scanEvents                      LibraryStockVerificationScanEvent[]

  @@unique([sessionId, copyId])
  @@index([sessionId, observationStatus])
  @@index([sessionId, resolutionStatus])
  @@index([copyId])
}

model LibraryStockVerificationScanEvent {
  id               String                          @id @default(cuid())
  sessionId        String
  session          LibraryStockVerificationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  recordId         String?
  record           LibraryStockVerificationRecord? @relation(fields: [recordId], references: [id], onDelete: Restrict)
  normalizedInput  String
  scanMethod       String
  resultType       String
  scannedAt        DateTime
  notes            String?
  recordedByUserId String?
  recordedBy       User?                           @relation("LibraryStockScanRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                        @default(now())

  @@index([sessionId, scannedAt])
  @@index([recordId])
  @@index([resultType])
}

model LibraryStockVerificationEvent {
  id               String                          @id @default(cuid())
  sessionId        String
  session          LibraryStockVerificationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  eventType        String
  eventDate        DateTime
  notes            String?
  recordedByUserId String?
  recordedBy       User?                           @relation("LibraryStockEventRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                        @default(now())

  @@index([sessionId, eventDate])
  @@index([eventType])
}

model LibraryMember {
  id               String               @id @default(cuid())
  memberCode       String               @unique
  memberType       String
  studentId        String?              @unique
  student          Student?             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  staffMemberId    String?              @unique
  staffMember      StaffMember?         @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  status           String               @default("ACTIVE")
  joinedDate       DateTime
  suspendedUntil   DateTime?
  suspensionReason String?
  notes            String?
  createdByUserId  String?
  createdBy        User?                @relation("LibraryMemberCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId  String?
  updatedBy        User?                @relation("LibraryMemberUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  loans            LibraryLoan[]
  reservations     LibraryReservation[]
  events           LibraryLoanEvent[]
  incidents        LibraryIncident[]
  charges          LibraryCharge[]

  @@index([memberType, status])
  @@index([joinedDate])
}

model LibraryPolicy {
  id                String   @id @default(cuid())
  policyCode        String   @unique
  name              String
  memberType        String
  className         String?
  staffType         String?
  maxActiveLoans    Int
  loanPeriodDays    Int
  maxRenewals       Int
  renewalPeriodDays Int
  reservationLimit  Int
  status            String   @default("ACTIVE")
  priority          Int      @default(0)
  notes             String?
  createdByUserId   String?
  createdBy         User?    @relation("LibraryPolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([memberType, status, priority])
  @@index([className, status])
  @@index([staffType, status])
}

model LibraryLoan {
  id                        String              @id @default(cuid())
  loanNumber                String              @unique
  copyId                    String
  copy                      LibraryCopy         @relation(fields: [copyId], references: [id], onDelete: Restrict)
  memberId                  String
  member                    LibraryMember       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  status                    String              @default("ISSUED")
  activeCopyKey             String?             @unique
  issueDate                 DateTime
  dueDate                   DateTime
  returnedDate              DateTime?
  renewCount                Int                 @default(0)
  policyCodeSnapshot        String
  loanPeriodDaysSnapshot    Int
  maxRenewalsSnapshot       Int
  renewalPeriodDaysSnapshot Int
  issueConditionSnapshot    String
  returnConditionSnapshot   String?
  issueNotes                String?
  returnNotes               String?
  cancellationReason        String?
  issuedByUserId            String?
  issuedBy                  User?               @relation("LibraryLoanIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  returnedByUserId          String?
  returnedBy                User?               @relation("LibraryLoanReturnedBy", fields: [returnedByUserId], references: [id], onDelete: SetNull)
  cancelledByUserId         String?
  cancelledBy               User?               @relation("LibraryLoanCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  events                    LibraryLoanEvent[]
  fulfilledReservation      LibraryReservation?
  incidents                 LibraryIncident[]
  charges                   LibraryCharge[]

  @@index([memberId, status])
  @@index([copyId, status])
  @@index([status, dueDate])
  @@index([issueDate])
  @@index([returnedDate])
}

model LibraryReservation {
  id                   String             @id @default(cuid())
  reservationNumber    String             @unique
  titleId              String
  title                LibraryTitle       @relation(fields: [titleId], references: [id], onDelete: Restrict)
  memberId             String
  member               LibraryMember      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  status               String             @default("WAITING")
  activeMemberTitleKey String?            @unique
  requestedDate        DateTime
  expiresDate          DateTime?
  fulfilledLoanId      String?            @unique
  fulfilledLoan        LibraryLoan?       @relation(fields: [fulfilledLoanId], references: [id], onDelete: Restrict)
  fulfilledAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdByUserId      String?
  createdBy            User?              @relation("LibraryReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fulfilledByUserId    String?
  fulfilledBy          User?              @relation("LibraryReservationFulfilledBy", fields: [fulfilledByUserId], references: [id], onDelete: SetNull)
  cancelledByUserId    String?
  cancelledBy          User?              @relation("LibraryReservationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  events               LibraryLoanEvent[]

  @@index([titleId, status, requestedDate, createdAt])
  @@index([memberId, status])
  @@index([status, expiresDate])
}

model LibraryLoanEvent {
  id               String              @id @default(cuid())
  loanId           String?
  loan             LibraryLoan?        @relation(fields: [loanId], references: [id], onDelete: Restrict)
  reservationId    String?
  reservation      LibraryReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  memberId         String
  member           LibraryMember       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  copyId           String?
  copy             LibraryCopy?        @relation(fields: [copyId], references: [id], onDelete: Restrict)
  titleId          String?
  title            LibraryTitle?       @relation(fields: [titleId], references: [id], onDelete: Restrict)
  eventType        String
  eventDate        DateTime
  previousDueDate  DateTime?
  newDueDate       DateTime?
  reason           String?
  notes            String?
  recordedByUserId String?
  recordedBy       User?               @relation("LibraryLoanEventRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())

  @@index([loanId, eventDate])
  @@index([reservationId, eventDate])
  @@index([memberId, eventDate])
  @@index([eventType, eventDate])
}

model LibraryIncident {
  id                 String               @id @default(cuid())
  incidentNumber     String               @unique
  incidentType       String
  status             String               @default("DRAFT")
  activeCaseKey      String?              @unique
  loanId             String
  loan               LibraryLoan          @relation(fields: [loanId], references: [id], onDelete: Restrict)
  memberId           String
  member             LibraryMember        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  copyId             String
  copy               LibraryCopy          @relation("LibraryIncidentCopy", fields: [copyId], references: [id], onDelete: Restrict)
  titleId            String
  title              LibraryTitle         @relation(fields: [titleId], references: [id], onDelete: Restrict)
  reportedDate       DateTime
  incidentCondition  String?
  description        String
  assessmentNotes    String?
  resolutionType     String?
  replacementCopyId  String?
  replacementCopy    LibraryCopy?         @relation("LibraryIncidentReplacementCopy", fields: [replacementCopyId], references: [id], onDelete: Restrict)
  resolvedDate       DateTime?
  resolutionNotes    String?
  cancellationReason String?
  createdByUserId    String?
  createdBy          User?                @relation("LibraryIncidentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submittedByUserId  String?
  submittedBy        User?                @relation("LibraryIncidentSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId   String?
  approvedBy         User?                @relation("LibraryIncidentApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  resolvedByUserId   String?
  resolvedBy         User?                @relation("LibraryIncidentResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  cancelledByUserId  String?
  cancelledBy        User?                @relation("LibraryIncidentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  submittedAt        DateTime?
  approvedAt         DateTime?
  resolvedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  charges            LibraryCharge[]
  events             LibraryChargeEvent[]

  @@index([status, incidentType])
  @@index([loanId, status])
  @@index([memberId, reportedDate])
  @@index([copyId, status])
