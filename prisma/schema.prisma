generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id                      String                                  @id @default(cuid())
  academicYear            String                                  @default("2026-27")
  admissionNo             String                                  @unique
  studentName             String
  fatherName              String
  motherName              String?
  className               String
  section                 String?
  rollNo                  String?
  phone1                  String
  phone2                  String?
  whatsappNumber          String?
  address                 String?
  dateOfBirth             DateTime?
  aadhaarNo               String?
  tcStatus                String?
  status                  String                                  @default("Active")
  studentType             String                                  @default("Normal")
  discountPercent         Float                                   @default(0)
  startMonth              String                                  @default("June")
  remarks                 String?
  deletedAt               DateTime?
  authLoginAliases        AuthLoginAlias[]
  createdAt               DateTime                                @default(now())
  updatedAt               DateTime                                @updatedAt
  payments                Payment[]
  familyAllocations       FamilyStudentAllocation[]
  guardians               StudentGuardian[]
  attendanceRecords       StudentAttendanceRecord[]
  academicYearEnrollments AcademicYearEnrollment[]
  lifecycleEvents         StudentLifecycleEvent[]
  progressionDecisions    StudentProgressionDecision[]
  miscIncomeReceipts      MiscIncomeReceipt[]
  bookSaleReceipts        BookSaleReceipt[]
  libraryMember           LibraryMember?
  libraryCharges          LibraryCharge[]
  examMarks               StudentMark[]
  governedExamMarkEntries ExamMarkEntry[]
  examResultSnapshots     StudentResultSnapshot[]
  reportCards             StudentReportCard[]
  classXDocumentPackages  ClassXDocumentPackage[]
  identityCards           IdentityCard[]
  classworkSubmissions    ClassworkSubmission[]
  departureRequests       StudentDepartureRequest[]
  departureStandingAuth   StudentStandingDepartureAuthorization[]
  campusPresenceEvents    StudentCampusPresenceEvent[]
  departureIncidents      StudentDepartureIncident[]

  @@index([academicYear])
  @@index([className, section])
  @@index([status])
}

model FeeStructure {
  id           String   @id @default(cuid())
  academicYear String   @default("2026-27")
  className    String
  termAmount   Float
  term1Month   String
  term2Month   String
  term3Month   String
  term4Month   String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([academicYear, className])
  @@index([academicYear])
}

model Payment {
  id                 String                      @id @default(cuid())
  date               DateTime
  receiptNo          String
  admissionNo        String
  studentId          String?
  student            Student?                    @relation(fields: [studentId], references: [id])
  studentName        String
  className          String
  section            String?
  amountPaid         Float
  paymentMode        String
  receivedAccount    String
  transactionRefNo   String?
  feeType            String
  termHint           String                      @default("Auto")
  remarks            String?
  enteredBy          String                      @default("Director")
  editedBy           String?
  isCancelled        Boolean                     @default(false)
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledBy        User?                       @relation("PaymentCancelledBy", fields: [cancelledByUserId], references: [id])
  cancellationReason String?
  deletedAt          DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  audits             PaymentAudit[]
  familyCollectionId String?
  familyCollection   FamilyCollection?           @relation(fields: [familyCollectionId], references: [id], onDelete: Restrict)
  familyInstrumentId String?
  familyInstrument   FamilyCollectionInstrument? @relation(fields: [familyInstrumentId], references: [id], onDelete: Restrict)
  familyAllocationId String?
  familyAllocation   FamilyStudentAllocation?    @relation(fields: [familyAllocationId], references: [id], onDelete: Restrict)
  familyShareId      String?                     @unique
  familyShare        AllocationInstrumentShare?  @relation(fields: [familyShareId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([receiptNo])
  @@index([admissionNo])
  @@index([feeType])
  @@index([paymentMode])
  @@index([receivedAccount])
  @@index([isCancelled])
  @@index([familyCollectionId])
  @@index([familyInstrumentId])
  @@index([familyAllocationId])
}

model FamilyCollection {
  id                        String                         @id @default(cuid())
  publicReference           String                         @unique
  receiptReference          String?                        @unique
  payerType                 String
  payerGuardianId           String?
  payerGuardian             Guardian?                      @relation(fields: [payerGuardianId], references: [id], onDelete: Restrict)
  payerDisplayName          String
  counterpartyReferenceHash String?
  counterpartyDisplay       String?
  collectionDate            DateTime
  status                    String                         @default("DRAFT")
  requestKey                String                         @unique
  requestFingerprint        String
  allocationPlanHash        String
  allocationPolicyVersion   String                         @default("FAMILY_AUTO_V1")
  totalPaise                Int
  creditPaise               Int                            @default(0)
  version                   Int                            @default(1)
  currentReceiptVersion     Int                            @default(0)
  auditReason               String?
  createdByUserId           String
  createdBy                 User                           @relation("FamilyCollectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedByUserId          String?
  reversedAt                DateTime?
  reversalReason            String?
  replacesCollectionId      String?                        @unique
  replacesCollection        FamilyCollection?              @relation("FamilyCollectionReplacement", fields: [replacesCollectionId], references: [id], onDelete: Restrict)
  replacedByCollection      FamilyCollection?              @relation("FamilyCollectionReplacement")
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  instruments               FamilyCollectionInstrument[]
  allocations               FamilyStudentAllocation[]
  receiptVersions           FamilyReceiptVersion[]         @relation("FamilyReceiptCollection")
  events                    FamilyCollectionEvent[]
  providerPlans             FamilyProviderAllocationPlan[]
  compatibilityPayments     Payment[]

  @@index([payerGuardianId, collectionDate])
  @@index([status, collectionDate])
  @@index([createdByUserId, collectionDate])
}

model FamilyCollectionInstrument {
  id                    String                      @id @default(cuid())
  collectionId          String
  collection            FamilyCollection            @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  ordinal               Int
  mode                  String
  amountPaise           Int
  receivedAccount       String
  referenceMasked       String?
  referenceKey          String?                     @unique
  postingStatus         String                      @default("POSTED")
  createdAt             DateTime                    @default(now())
  shares                AllocationInstrumentShare[]
  compatibilityPayments Payment[]

  @@unique([collectionId, ordinal])
  @@index([collectionId, postingStatus])
  @@index([mode, postingStatus])
}

model FamilyStudentAllocation {
  id                    String                      @id @default(cuid())
  collectionId          String
  collection            FamilyCollection            @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  studentId             String
  student               Student                     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear          String
  installment           String
  feeHead               String
  amountPaise           Int
  orderIndex            Int
  allocationPolicy      String
  dueBeforePaise        Int
  dueAfterPaise         Int
  dueSnapshotHash       String
  studentNameSnapshot   String
  admissionNoSnapshot   String
  classNameSnapshot     String
  sectionSnapshot       String?
  createdAt             DateTime                    @default(now())
  shares                AllocationInstrumentShare[]
  compatibilityPayments Payment[]

  @@unique([collectionId, studentId, academicYear, installment, feeHead])
  @@index([studentId, academicYear])
  @@index([collectionId, orderIndex])
}

model AllocationInstrumentShare {
  id           String                     @id @default(cuid())
  allocationId String
  allocation   FamilyStudentAllocation    @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  instrumentId String
  instrument   FamilyCollectionInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  amountPaise  Int
  createdAt    DateTime                   @default(now())
  payment      Payment?

  @@unique([allocationId, instrumentId])
  @@index([instrumentId])
}

model FamilyReceiptVersion {
  id                     String                @id @default(cuid())
  collectionId           String
  collection             FamilyCollection      @relation("FamilyReceiptCollection", fields: [collectionId], references: [id], onDelete: Restrict)
  versionNumber          Int
  publicVersionReference String                @unique
  status                 String
  totalPaise             Int
  snapshotJson           String
  supersedesVersionId    String?               @unique
  supersedesVersion      FamilyReceiptVersion? @relation("FamilyReceiptSupersession", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededByVersion    FamilyReceiptVersion? @relation("FamilyReceiptSupersession")
  issuedByUserId         String
  issuedBy               User                  @relation("FamilyReceiptIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  issuedAt               DateTime              @default(now())
  createdAt              DateTime              @default(now())

  @@unique([collectionId, versionNumber])
  @@index([collectionId, status])
}

model FamilyCollectionEvent {
  id                String           @id @default(cuid())
  collectionId      String
  collection        FamilyCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  eventType         String
  previousStatus    String?
  newStatus         String?
  collectionVersion Int
  actorUserId       String
  actor             User             @relation("FamilyCollectionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorName         String
  reason            String?
  detailsJson       String?
  createdAt         DateTime         @default(now())

  @@index([collectionId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
}

model FamilyProviderAllocationPlan {
  id                   String           @id @default(cuid())
  publicKey            String           @unique
  collectionId         String
  collection           FamilyCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  planVersion          Int
  status               String           @default("PREPARED")
  amountPaise          Int
  planHash             String
  snapshotJson         String
  providerOrderKeyHash String?
  createdByUserId      String
  createdAt            DateTime         @default(now())

  @@unique([collectionId, planVersion])
  @@index([status, createdAt])
}

model ReceiptNote {
  id        String   @id @default(cuid())
  receiptNo String   @unique
  status    String   @default("Cancelled")
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                               String                              @id @default(cuid())
  iamPublicKey                     String?                             @unique
  name                             String
  designation                      String?
  username                         String                              @unique
  email                            String?                             @unique
  passwordHash                     String
  credentialVersion                Int                                 @default(1)
  authorizationVersion             Int                                 @default(1)
  lifecycleStatus                  String                              @default("ACTIVE")
  mustChangePassword               Boolean                             @default(false)
  temporaryPasswordExpiresAt       DateTime?
  suspensionReason                 String?
  version                          Int                                 @default(1)
  role                             String
  isActive                         Boolean                             @default(true)
  lastLoginAt                      DateTime?
  createdAt                        DateTime                            @default(now())
  updatedAt                        DateTime                            @updatedAt
  paymentAudits                    PaymentAudit[]                      @relation("PaymentAuditChangedBy")
  cancelledPayments                Payment[]                           @relation("PaymentCancelledBy")
  familyCollectionsCreated         FamilyCollection[]                  @relation("FamilyCollectionCreatedBy")
  familyReceiptVersionsIssued      FamilyReceiptVersion[]              @relation("FamilyReceiptIssuedBy")
  familyCollectionEvents           FamilyCollectionEvent[]             @relation("FamilyCollectionEventActor")
  importBatches                    ImportBatch[]                       @relation("ImportBatchCreatedBy")
  timetableDrafts                  TimetableDraft[]                    @relation("TimetableDraftCreatedBy")
  noticesCreated                   Notice[]                            @relation("NoticeCreatedBy")
  noticesUpdated                   Notice[]                            @relation("NoticeUpdatedBy")
  guardianId                       String?                             @unique
  guardian                         Guardian?                           @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  staffMember                      StaffMember?
  attendanceSessionsTaken          StudentAttendanceSession[]          @relation("AttendanceTakenBy")
  attendanceSessionsSubmitted      StudentAttendanceSession[]          @relation("AttendanceSubmittedBy")
  attendanceSessionsLocked         StudentAttendanceSession[]          @relation("AttendanceLockedBy")
  staffAttendanceSessionsTaken     StaffAttendanceSession[]            @relation("StaffAttendanceTakenBy")
  staffAttendanceSessionsSubmitted StaffAttendanceSession[]            @relation("StaffAttendanceSubmittedBy")
  staffAttendanceSessionsLocked    StaffAttendanceSession[]            @relation("StaffAttendanceLockedBy")
  staffLeaveRequestsRequested      StaffLeaveRequest[]                 @relation("StaffLeaveRequestedBy")
  staffLeaveRequestsApproved       StaffLeaveRequest[]                 @relation("StaffLeaveApprovedBy")
  staffLeaveRequestsCancelled      StaffLeaveRequest[]                 @relation("StaffLeaveCancelledBy")
  substituteAssignmentsAssigned    SubstituteAssignment[]              @relation("SubstituteAssignedBy")
  substituteAssignmentsConfirmed   SubstituteAssignment[]              @relation("SubstituteConfirmedBy")
  substituteAssignmentsCompleted   SubstituteAssignment[]              @relation("SubstituteCompletedBy")
  substituteAssignmentsCancelled   SubstituteAssignment[]              @relation("SubstituteCancelledBy")
  lifecycleEventsApproved          StudentLifecycleEvent[]             @relation("LifecycleApprovedBy")
  lifecycleEventsRecorded          StudentLifecycleEvent[]             @relation("LifecycleRecordedBy")
  progressionDecisionsCreated      StudentProgressionDecision[]        @relation("ProgressionCreatedBy")
  progressionDecisionsSubmitted    StudentProgressionDecision[]        @relation("ProgressionSubmittedBy")
  progressionDecisionsApproved     StudentProgressionDecision[]        @relation("ProgressionApprovedBy")
  progressionDecisionsFinalized    StudentProgressionDecision[]        @relation("ProgressionFinalizedBy")
  progressionDecisionsCancelled    StudentProgressionDecision[]        @relation("ProgressionCancelledBy")
  vendorsCreated                   Vendor[]                            @relation("VendorCreatedBy")
  expensesCreated                  ExpenseRecord[]                     @relation("ExpenseCreatedBy")
  expensesSubmitted                ExpenseRecord[]                     @relation("ExpenseSubmittedBy")
  expensesApproved                 ExpenseRecord[]                     @relation("ExpenseApprovedBy")
  expensesPaid                     ExpenseRecord[]                     @relation("ExpensePaidBy")
  expensesCancelled                ExpenseRecord[]                     @relation("ExpenseCancelledBy")
  expensePaymentsRecorded          ExpensePayment[]                    @relation("ExpensePaymentRecordedBy")
  expenseAudits                    ExpenseAudit[]                      @relation("ExpenseAuditActor")
  budgetPlansCreated               BudgetPlan[]                        @relation("BudgetPlanCreatedBy")
  budgetPlansSubmitted             BudgetPlan[]                        @relation("BudgetPlanSubmittedBy")
  budgetPlansApproved              BudgetPlan[]                        @relation("BudgetPlanApprovedBy")
  budgetPlansLocked                BudgetPlan[]                        @relation("BudgetPlanLockedBy")
  budgetPlansCancelled             BudgetPlan[]                        @relation("BudgetPlanCancelledBy")
  budgetRevisionsCreated           BudgetRevision[]                    @relation("BudgetRevisionCreatedBy")
  budgetRevisionsSubmitted         BudgetRevision[]                    @relation("BudgetRevisionSubmittedBy")
  budgetRevisionsApproved          BudgetRevision[]                    @relation("BudgetRevisionApprovedBy")
  miscIncomeItemsCreated           MiscIncomeItem[]                    @relation("MiscIncomeItemCreatedBy")
  miscIncomeReceiptsCreated        MiscIncomeReceipt[]                 @relation("MiscIncomeReceiptCreatedBy")
  miscIncomeReceiptsCancelled      MiscIncomeReceipt[]                 @relation("MiscIncomeReceiptCancelledBy")
  cashBookDaysCreated              CashBookDay[]                       @relation("CashBookDayCreatedBy")
  cashBookDaysSubmitted            CashBookDay[]                       @relation("CashBookDaySubmittedBy")
  cashBookDaysApproved             CashBookDay[]                       @relation("CashBookDayApprovedBy")
  cashBookDaysLocked               CashBookDay[]                       @relation("CashBookDayLockedBy")
  cashBookDaysCancelled            CashBookDay[]                       @relation("CashBookDayCancelledBy")
  cashBookMovementsRecorded        CashBookMovement[]                  @relation("CashBookMovementRecordedBy")
  cashBookMovementsCancelled       CashBookMovement[]                  @relation("CashBookMovementCancelledBy")
  bookCatalogItemsCreated          BookCatalogItem[]                   @relation("BookCatalogItemCreatedBy")
  bookSaleReceiptsCreated          BookSaleReceipt[]                   @relation("BookSaleReceiptCreatedBy")
  bookSaleReceiptsCancelled        BookSaleReceipt[]                   @relation("BookSaleReceiptCancelledBy")
  bookCashSettlementsCreated       BookCashSettlement[]                @relation("BookCashSettlementCreatedBy")
  bookCashSettlementsSubmitted     BookCashSettlement[]                @relation("BookCashSettlementSubmittedBy")
  bookCashSettlementsApproved      BookCashSettlement[]                @relation("BookCashSettlementApprovedBy")
  bookCashSettlementsCancelled     BookCashSettlement[]                @relation("BookCashSettlementCancelledBy")
  libraryTitlesCreated             LibraryTitle[]                      @relation("LibraryTitleCreatedBy")
  libraryCopiesCreated             LibraryCopy[]                       @relation("LibraryCopyCreatedBy")
  libraryCopiesUpdated             LibraryCopy[]                       @relation("LibraryCopyUpdatedBy")
  libraryCopyEventsRecorded        LibraryCopyEvent[]                  @relation("LibraryCopyEventRecordedBy")
  libraryMembersCreated            LibraryMember[]                     @relation("LibraryMemberCreatedBy")
  libraryMembersUpdated            LibraryMember[]                     @relation("LibraryMemberUpdatedBy")
  libraryPoliciesCreated           LibraryPolicy[]                     @relation("LibraryPolicyCreatedBy")
  libraryLoansIssued               LibraryLoan[]                       @relation("LibraryLoanIssuedBy")
  libraryLoansReturned             LibraryLoan[]                       @relation("LibraryLoanReturnedBy")
  libraryLoansCancelled            LibraryLoan[]                       @relation("LibraryLoanCancelledBy")
  libraryReservationsCreated       LibraryReservation[]                @relation("LibraryReservationCreatedBy")
  libraryReservationsFulfilled     LibraryReservation[]                @relation("LibraryReservationFulfilledBy")
  libraryReservationsCancelled     LibraryReservation[]                @relation("LibraryReservationCancelledBy")
  libraryLoanEventsRecorded        LibraryLoanEvent[]                  @relation("LibraryLoanEventRecordedBy")
  libraryChargeRulesCreated        LibraryChargeRule[]                 @relation("LibraryChargeRuleCreatedBy")
  libraryIncidentsCreated          LibraryIncident[]                   @relation("LibraryIncidentCreatedBy")
  libraryIncidentsSubmitted        LibraryIncident[]                   @relation("LibraryIncidentSubmittedBy")
  libraryIncidentsApproved         LibraryIncident[]                   @relation("LibraryIncidentApprovedBy")
  libraryIncidentsResolved         LibraryIncident[]                   @relation("LibraryIncidentResolvedBy")
  libraryIncidentsCancelled        LibraryIncident[]                   @relation("LibraryIncidentCancelledBy")
  libraryChargesCreated            LibraryCharge[]                     @relation("LibraryChargeCreatedBy")
  libraryChargesApproved           LibraryCharge[]                     @relation("LibraryChargeApprovedBy")
  libraryChargesWaived             LibraryCharge[]                     @relation("LibraryChargeWaivedBy")
  libraryChargesCollected          LibraryCharge[]                     @relation("LibraryChargeCollectedBy")
  libraryChargesCancelled          LibraryCharge[]                     @relation("LibraryChargeCancelledBy")
  libraryChargeEventsRecorded      LibraryChargeEvent[]                @relation("LibraryChargeEventRecordedBy")
  libraryStockSessionsCreated      LibraryStockVerificationSession[]   @relation("LibraryStockSessionCreatedBy")
  libraryStockSessionsStarted      LibraryStockVerificationSession[]   @relation("LibraryStockSessionStartedBy")
  libraryStockSessionsSubmitted    LibraryStockVerificationSession[]   @relation("LibraryStockSessionSubmittedBy")
  libraryStockSessionsReviewed     LibraryStockVerificationSession[]   @relation("LibraryStockSessionReviewedBy")
  libraryStockSessionsApproved     LibraryStockVerificationSession[]   @relation("LibraryStockSessionApprovedBy")
  libraryStockSessionsLocked       LibraryStockVerificationSession[]   @relation("LibraryStockSessionLockedBy")
  libraryStockSessionsCancelled    LibraryStockVerificationSession[]   @relation("LibraryStockSessionCancelledBy")
  libraryStockRecordsObserved      LibraryStockVerificationRecord[]    @relation("LibraryStockRecordObservedBy")
  libraryStockRecordsReviewed      LibraryStockVerificationRecord[]    @relation("LibraryStockRecordReviewedBy")
  libraryStockRecordsApplied       LibraryStockVerificationRecord[]    @relation("LibraryStockRecordAppliedBy")
  libraryStockScansRecorded        LibraryStockVerificationScanEvent[] @relation("LibraryStockScanRecordedBy")
  libraryStockEventsRecorded       LibraryStockVerificationEvent[]     @relation("LibraryStockEventRecordedBy")
  homeworkAssignmentsCreated       HomeworkAssignment[]                @relation("HomeworkCreatedBy")
  homeworkAssignmentsPublished     HomeworkAssignment[]                @relation("HomeworkPublishedBy")
  homeworkAssignmentsArchived      HomeworkAssignment[]                @relation("HomeworkArchivedBy")
  homeworkAssignmentsCancelled     HomeworkAssignment[]                @relation("HomeworkCancelledBy")
  homeworkEventsRecorded           HomeworkAssignmentEvent[]           @relation("HomeworkEventRecordedBy")
  notificationRecipients           NotificationRecipient[]
  authLoginAliases                 AuthLoginAlias[]
  authVerificationChallenges       AuthVerificationChallenge[]
  authPasswordResetTokens          AuthPasswordResetToken[]
  authSessions                     AuthSession[]
  authSecurityEvents               AuthSecurityEvent[]                 @relation("AuthSecurityEventSubject")
  authSecurityEventsActed          AuthSecurityEvent[]                 @relation("AuthSecurityEventActor")
  iamRoleAssignments               UserRoleAssignment[]
  iamProfileAssignments            UserPermissionProfileAssignment[]
  iamPermissionOverrides           UserPermissionOverride[]

  @@index([role])
  @@index([isActive])
  @@index([guardianId])
  @@index([lifecycleStatus])
  @@index([authorizationVersion])
}

model AcademicYearEnrollment {
  id                   String                       @id @default(cuid())
  studentId            String
  student              Student                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear         String
  className            String
  section              String?
  rollNo               String?
  status               String                       @default("ACTIVE")
  enrollmentDate       DateTime?
  exitDate             DateTime?
  exitReason           String?
  notes                String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  progressionDecisions StudentProgressionDecision[] @relation("ProgressionSourceEnrollment")

  @@unique([studentId, academicYear])
  @@index([academicYear, className, section])
  @@index([academicYear, status])
  @@index([studentId, createdAt])
}

model StudentProgressionDecision {
  id                         String                  @id @default(cuid())
  studentId                  String
  student                    Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sourceEnrollmentId         String?
  sourceEnrollment           AcademicYearEnrollment? @relation("ProgressionSourceEnrollment", fields: [sourceEnrollmentId], references: [id], onDelete: SetNull)
  academicYear               String
  decisionType               String
  status                     String                  @default("DRAFT")
  fromClass                  String?
  fromSection                String?
  fromStatus                 String?
  toAcademicYear             String?
  toClass                    String?
  toSection                  String?
  toStatus                   String?
  effectiveDate              DateTime
  reason                     String?
  evidenceNotes              String?
  marksSummary               String?
  attendanceSummary          String?
  parentRequestNotes         String?
  parentAcknowledgementNotes String?
  feeWarningNotes            String?
  udiseReviewNotes           String?
  destinationSchool          String?
  followUpNotes              String?
  rejectionReason            String?
  cancellationReason         String?
  createdByUserId            String?
  createdBy                  User?                   @relation("ProgressionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submittedByUserId          String?
  submittedBy                User?                   @relation("ProgressionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId           String?
  approvedBy                 User?                   @relation("ProgressionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  finalizedByUserId          String?
  finalizedBy                User?                   @relation("ProgressionFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  cancelledByUserId          String?
  cancelledBy                User?                   @relation("ProgressionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  submittedAt                DateTime?
  approvedAt                 DateTime?
  finalizedAt                DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([studentId, createdAt])
  @@index([academicYear, decisionType, status])
  @@index([sourceEnrollmentId])
  @@index([createdByUserId])
  @@index([approvedByUserId])
}

model StudentLifecycleEvent {
  id                         String   @id @default(cuid())
  studentId                  String
  student                    Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear               String?
  eventType                  String
  fromClass                  String?
  fromSection                String?
  toClass                    String?
  toSection                  String?
  fromStatus                 String?
  toStatus                   String?
  effectiveDate              DateTime
  reason                     String?
  evidenceNotes              String?
  parentAcknowledgementNotes String?
  approvedByUserId           String?
  approvedBy                 User?    @relation("LifecycleApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  recordedByUserId           String?
  recordedBy                 User?    @relation("LifecycleRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([studentId, effectiveDate])
  @@index([academicYear, eventType])
  @@index([approvedByUserId])
  @@index([recordedByUserId])
}

model StudentAttendanceSession {
  id                            String                    @id @default(cuid())
  attendanceDate                DateTime
  className                     String
  section                       String                    @default("")
  academicYear                  String                    @default("2026-27")
  status                        String                    @default("DRAFT")
  takenByUserId                 String?
  takenBy                       User?                     @relation("AttendanceTakenBy", fields: [takenByUserId], references: [id], onDelete: SetNull)
  submittedByUserId             String?
  submittedBy                   User?                     @relation("AttendanceSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  lockedByUserId                String?
  lockedBy                      User?                     @relation("AttendanceLockedBy", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  submittedAt                   DateTime?
  lockedAt                      DateTime?
  notes                         String?
  operationalCalendarVersionKey String?
  operationalCalendarDayKey     String?
  calendarBasisSnapshotJson     String?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  records                       StudentAttendanceRecord[]

  @@unique([attendanceDate, className, section, academicYear])
  @@index([attendanceDate])
  @@index([academicYear, className, section])
  @@index([status])
  @@index([operationalCalendarVersionKey])
}

model StudentAttendanceRecord {
  id          String                   @id @default(cuid())
  sessionId   String
  session     StudentAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  admissionNo String
  status      String
  remarks     String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([status])
}

model StaffMember {
