  budgetPlan               BudgetPlan         @relation(fields: [budgetPlanId], references: [id], onDelete: Restrict)
  categoryId               String?
  category                 ExpenseCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  departmentId             String?
  department               ExpenseDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  allocationKey            String
  allocatedAmount          Decimal
  warningThresholdPercent  Int?
  criticalThresholdPercent Int?
  notes                    String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@unique([budgetPlanId, allocationKey])
  @@index([budgetPlanId])
  @@index([categoryId])
  @@index([departmentId])
}

model BudgetRevision {
