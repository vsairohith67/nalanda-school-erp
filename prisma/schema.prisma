}

model StudentDepartureNotificationOutbox {
  id                    String                  @id @default(cuid())
  publicKey             String                  @unique @default(uuid())
  requestId             String
  request               StudentDepartureRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  eventKey              String
  eventType             String
  recipientUserId       String
  recipientGuardianId   String?
  channel               String
  status                String                  @default("QUEUED")
  minimalMessageCode    String
  retryCount            Int                     @default(0)
  nextAttemptAt         DateTime?
