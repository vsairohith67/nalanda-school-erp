  @@index([budgetPlanId, status])
}

model MiscIncomeItem {
  id                String                  @id @default(cuid())
  itemCode          String                  @unique
  name              String
  description       String?
  category          String
  studentLinkPolicy String
  status            String                  @default("ACTIVE")
  createdByUserId   String?
  createdBy         User?                   @relation("MiscIncomeItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  rates             MiscIncomeRate[]
  receiptLines      MiscIncomeReceiptLine[]

