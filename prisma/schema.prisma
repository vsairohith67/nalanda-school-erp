// Prompt 23H: privacy-minimised admissions and enquiry CRM. Applicant records
// remain prospective until one governed, transaction-safe conversion succeeds.
model AdmissionCycle {
  id                     String                 @id @default(cuid())
  publicKey              String                 @unique @default(uuid())
  cycleCode              String                 @unique
  name                   String
  academicYear           String
