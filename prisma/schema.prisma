  queuedAt              DateTime                @default(now())
  sentAt                DateTime?
  deliveredAt           DateTime?
  failedAt              DateTime?
  providerReferenceSafe String?
  failureCode           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([eventKey, recipientUserId, channel])
  @@index([status, nextAttemptAt])
  @@index([requestId, queuedAt])
}

model StudentDepartureFallbackTask {
