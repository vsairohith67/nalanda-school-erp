  bookSalesCashSnapshot    Decimal            @default(0)
  cashExpenseSnapshot      Decimal            @default(0)
  manualInflowSnapshot     Decimal            @default(0)
  manualOutflowSnapshot    Decimal            @default(0)
  bankDepositSnapshot      Decimal            @default(0)
  directorHandoverSnapshot Decimal            @default(0)
  calculatedClosingBalance Decimal            @default(0)
  countedClosingBalance    Decimal?
  varianceAmount           Decimal?
  sourceSummarySnapshot    String?
  notes                    String?
  rejectionReason          String?
  cancellationReason       String?
  createdByUserId          String?
  createdBy                User?              @relation("CashBookDayCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submittedByUserId        String?
  submittedBy              User?              @relation("CashBookDaySubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId         String?
  approvedBy               User?              @relation("CashBookDayApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lockedByUserId           String?
  lockedBy                 User?              @relation("CashBookDayLockedBy", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  cancelledByUserId        String?
  cancelledBy              User?              @relation("CashBookDayCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  submittedAt              DateTime?
  approvedAt               DateTime?
  lockedAt                 DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
