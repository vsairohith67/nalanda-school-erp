// SAFE-EXIT-1A: governed Student early departure, single-use gate pass,
// campus-presence ledger and restricted unauthorised-exit incident workflow.
model StudentDepartureRequest {
  id                          String                               @id @default(cuid())
  publicKey                   String                               @unique @default(uuid())
  requestNumber               String                               @unique
  submissionKey               String                               @unique
  source                      String
  studentId                   String
  student                     Student                              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear                String
  reasonCategory              String
  reasonDetails               String?
  calendarBasisJson           String
  intendedHandoverMethod      String
  intendedDepartureAt         DateTime
  status                      String                               @default("REQUESTED")
  consentState                String                               @default("PENDING")
  version                     Int                                  @default(1)
  approvedHandoverMethod      String?
  approvedRecipientName       String?
  approvedRelationship        String?
  approvedContactMasked       String?
  parentAuthorisationEvidence String?
  verificationReference       String?
  approvedDepartureAt         DateTime?
  approvalExpiresAt           DateTime?
  activeCheckoutKey           String?                              @unique
  emergencyOverride           Boolean                              @default(false)
  restricted                  Boolean                              @default(false)
  requestedByUserId           String
  requestedByRole             String
  approvedByUserId            String?
  rejectedByUserId            String?
  cancelledByUserId           String?
  checkedOutByUserId          String?
  returnedByUserId            String?
  submittedAt                 DateTime                             @default(now())
  approvedAt                  DateTime?
  rejectedAt                  DateTime?
  cancelledAt                 DateTime?
  checkedOutAt                DateTime?
  returnedAt                  DateTime?
  closedAt                    DateTime?
  expiresAt                   DateTime?
  createdAt                   DateTime                             @default(now())
  updatedAt                   DateTime                             @updatedAt
  consentEvidence             StudentDepartureConsentEvidence[]
  gatePasses                  StudentGatePass[]
  handovers                   StudentDepartureHandover[]
  events                      StudentDepartureEvent[]
  campusPresenceEvents        StudentCampusPresenceEvent[]
  incidents                   StudentDepartureIncident[]
  notificationOutbox          StudentDepartureNotificationOutbox[]
  fallbackTasks               StudentDepartureFallbackTask[]

  @@index([studentId, submittedAt])
  @@index([status, intendedDepartureAt])
  @@index([academicYear, status])
  @@index([requestedByUserId, submittedAt])
}

model StudentDepartureConsentEvidence {
  id                       String                  @id @default(cuid())
  publicKey                String                  @unique @default(uuid())
  requestId                String
  request                  StudentDepartureRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  outcome                  String
  method                   String
  guardianId               String?
  guardian                 Guardian?               @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  guardianLinkSnapshotHash String?
  contactMasked            String?
  telephoneAttemptSummary  String?
  witnessUserId            String?
  supervisorUserId         String?
  privateDocumentReference String?
  standingAuthorizationKey String?
  recordedByUserId         String
  recordedByRole           String
  notes                    String?
  recordedAt               DateTime                @default(now())
  createdAt                DateTime                @default(now())

  @@index([requestId, recordedAt])
  @@index([guardianId, recordedAt])
}

model StudentStandingDepartureAuthorization {
  id                     String   @id @default(cuid())
  publicKey              String   @unique @default(uuid())
  seriesKey              String
  versionNumber          Int
  studentId              String
  student                Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardianId             String
  guardian               Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  status                 String
  allowsSelfDeparture    Boolean  @default(false)
  eligibleClassSnapshot  String
  allowedDaysJson        String
  allowedStartMinute     Int
  allowedEndMinute       Int
  effectiveFrom          DateTime
  effectiveUntil         DateTime
  conditions             String?
  guardianApprovalMethod String
  guardianApprovedAt     DateTime
  supersedesPublicKey    String?
  revocationReason       String?
  createdByUserId        String
  createdByRole          String
  createdAt              DateTime @default(now())

  @@unique([seriesKey, versionNumber])
  @@index([studentId, createdAt])
  @@index([guardianId, createdAt])
  @@index([seriesKey, versionNumber])
}

model StudentGatePass {
