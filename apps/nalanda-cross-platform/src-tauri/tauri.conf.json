{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nalanda Public School ERP",
  "version": "0.1.0",
  "identifier": "com.nalandaps.erp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nalanda Public School ERP",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Secure ERP workspace for Nalanda Public School",
    "longDescription": "Default-off offline finance draft and governed online ERP workspace.",
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true }
    },
    "android": { "minSdkVersion": 28 },
    "iOS": { "minimumSystemVersion": "15.0" }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["nalandaps-erp"] },
      "mobile": [{ "scheme": ["nalandaps-erp"], "host": "auth", "pathPrefix": ["/callback"] }]
    }
  }
}
