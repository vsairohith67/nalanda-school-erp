# Names and safe placeholders only. Never commit a completed copy.
NODE_ENV=production
NALANDA_ENVIRONMENT=staging
NALANDA_DEPLOYMENT_ID=staging-<utc>-<commit>
NALANDA_LOCAL_REHEARSAL=false
APP_ORIGIN=https://staging.nalandaps.com
PUBLIC_WEBSITE_URL=https://staging.nalandaps.com
PUBLIC_WEBSITE_INDEXING_ENABLED=false
SESSION_COOKIE_SECURE=true
ENABLE_HSTS=true
ENABLE_HTTPS_UPGRADE=true
TRUST_PROXY_HEADERS=true
NALANDA_TRUSTED_PROXY_MODE=single-hop-sanitized
STAGING_DATA_DIR=/var/lib/nalanda
DATABASE_URL=file:/var/lib/nalanda/data/database/staging.db
FEE_REGISTER_OCR_STORAGE_DIR=/var/lib/nalanda/uploads/fee-register-ocr
BACKUP_DIRECTORY=/var/lib/nalanda/backups/json
CLOUD_BACKUP_LOCAL_FOLDER=/var/lib/nalanda/backups/encrypted
CLOUD_BACKUP_TEMP_DIR=/var/lib/nalanda/data/temp/cloud-backup
CLOUD_BACKUP_REHEARSAL_DIR=/var/lib/nalanda/data/temp/restore-rehearsal
NEXT_PUBLIC_PWA_BUILD_VERSION=staging-<utc>-<commit>
AUTH_SECRET=<secret-store-reference>
FIRST_RUN_BOOTSTRAP_TOKEN=<secret-store-reference>
WHATSAPP_MOCK_WEBHOOK_SECRET=<secret-store-reference>
WHATSAPP_MOCK_VERIFY_TOKEN=<secret-store-reference>
WHATSAPP_PHONE_HASH_PEPPER=<secret-store-reference>
SMS_EMAIL_MOCK_WEBHOOK_SECRET=<secret-store-reference>
SMS_EMAIL_CONTACT_HASH_PEPPER=<secret-store-reference>
AI_ASSISTANT_AUDIT_HASH_PEPPER=<secret-store-reference>
CLOUD_BACKUP_ENCRYPTION_KEY_V1=<secret-store-reference>
WHATSAPP_LIVE_SENDING_ENABLED=false
SMS_EMAIL_SMS_LIVE_ENABLED=false
SMS_EMAIL_EMAIL_LIVE_ENABLED=false
SMS_EMAIL_SUPERVISED_LIVE_ACTIVATION_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
DEBUG=false
NEXT_PUBLIC_DEBUG=false
NALANDA_DEBUG=false

# The STAGING_SYNTHETIC_*_PASSWORD values used by the one-time synthetic seed
# are deliberately absent. Inject unique temporary values only for that command,
# do not echo them, then remove them from the shell and long-running environment.
