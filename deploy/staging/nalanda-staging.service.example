[Unit]
Description=Nalanda ERP synthetic staging
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=nalanda
Group=nalanda
WorkingDirectory=/opt/nalanda/current
EnvironmentFile=/etc/nalanda/staging.env
ExecStartPre=/usr/bin/test -r /opt/nalanda/current/package.json
ExecStartPre=/usr/bin/test -w /var/lib/nalanda/data
ExecStartPre=/usr/bin/test -w /var/lib/nalanda/uploads
ExecStartPre=/usr/bin/test -w /var/lib/nalanda/backups
ExecStartPre=/usr/bin/test -w /var/cache/nalanda/next
ExecStart=/usr/bin/node /opt/nalanda/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/nalanda
ReadWritePaths=/var/lib/nalanda/data /var/lib/nalanda/uploads /var/lib/nalanda/backups /var/cache/nalanda/next /var/log/nalanda /run/nalanda
StateDirectory=nalanda
CacheDirectory=nalanda
LogsDirectory=nalanda
RuntimeDirectory=nalanda
RuntimeDirectoryMode=0700
UMask=0077
LimitNOFILE=16384
TasksMax=256
MemoryHigh=1280M
MemoryMax=1536M
MemorySwapMax=512M

[Install]
WantedBy=multi-user.target
