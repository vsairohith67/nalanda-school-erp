{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": ["arn:aws:s3:::nalanda-portable-synthetic-private"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::nalanda-portable-synthetic-private"],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "private/admissions/*",
            "private/classwork/*",
            "private/support/*",
            "private/event-media/*",
            "private/payslip/*",
            "private/reports/*",
            "private/exports/*",
            "private/identity-cards/*",
            "private/onboarding/*",
            "private/fee-register-ocr/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/admissions/*",
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/classwork/*",
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/support/*",
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/event-media/*",
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/payslip/*",
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/reports/*",
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/exports/*",
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/identity-cards/*",
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/onboarding/*",
        "arn:aws:s3:::nalanda-portable-synthetic-private/private/fee-register-ocr/*"
      ]
    }
  ]
}
