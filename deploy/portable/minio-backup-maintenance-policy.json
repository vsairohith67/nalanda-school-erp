{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketVersioning"],
      "Resource": ["arn:aws:s3:::nalanda-portable-synthetic-private"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObjectVersion", "s3:DeleteObjectVersion"],
      "Resource": ["arn:aws:s3:::nalanda-portable-synthetic-private/private/backups/*"]
    }
  ]
}
