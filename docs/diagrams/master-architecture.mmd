flowchart LR
  UI["Authenticated web UI"] --> APP["Next.js page and API layer"]
  APP --> UX["Shared UX Shell\nlogin, header, navigation, account and responsive tokens"]
  UX --> AUTH
  APP --> AUTH["Session, role and permission gates"]
  AUTH --> IAM["IAM-1A Named Access\nrole assignments, profiles, grants and denials"]
  IAM --> CTX["Server-held Context\nopaque role and linked-child handles"]
  CTX --> SCOPE["Exact Object Scope\nTeacher, Parent, finance and ownership"]
  IAM --> AUDIT
  SCOPE --> DATA
  AUTH --> TAS["Teacher Attendance Scope\nexact active timetable or dated substitute"]
  AUTH --> EXAM["Versioned Examination Configuration\nPrincipal setup and exact Teacher assignment"]
  AUTH --> PARENT23D["Parent Academic Context\nopaque child, Guardian and enrollment proof"]
  AUTH --> GOV["Separately governed leadership and other-role scopes"]
  TAS --> DATA["Prisma / operational SQLite"]
  EXAM --> DATA
  EXAM --> EXAMTIME["Governed Examination Timetable\ndraft, validation, immutable publication and replacement"]
  EXAMTIME --> DATA
  PARENT23D --> ATTENDVIEW["Official Attendance Projection\ncounts only; no inferred percentage"]
  PARENT23D --> EXAMTIME
  AUTH --> CAL23E["Governed Academic Calendar\noperational days separate from events"]
  CAL23E --> CALBASIS["Immutable published working-day basis\nand attendance-impact evidence"]
  CAL23E --> CALEVENT["Versioned internal events\nserver-resolved audience and replacement"]
  CALEVENT --> PARENT23D
  CALEVENT --> TAS
  CALEVENT --> EXAMTIME
  CALBASIS --> DATA
  CALEVENT --> DATA
  ATTENDVIEW --> DATA
  EXAM --> MARKS["Marks and Moderation\nexact Teacher entry, immutable versions and calculation snapshots"]
  MARKS --> DATA
  MARKS --> CALC["Frozen RAW_SUM / WEIGHTED_NORMALIZED engine"]
  CALC --> SNAP["Immutable Student result snapshots\npublication not implemented"]
  MARKS --> AUDIT
  GOV --> DATA
  DATA --> AUDIT["Append-only audit and versioned backup"]
