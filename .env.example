# Copy this file to .env for local use. Never commit the resulting .env file.
# Every credential, secret, provider value, and deployment origin is environment-only.

# Local disposable database only. Do not point this template at the operational database.
DATABASE_URL="file:./local-example.db"

# Generate unique values locally. Never copy production or operational values here.
AUTH_SECRET="<generate-locally-at-least-32-random-characters>"
SESSION_SECRET="<generate-locally-at-least-32-random-characters>"
AUTH_VERIFICATION_SECRET="<generate-locally-at-least-32-random-characters>"
SESSION_COOKIE_SECURE="false"
APP_ORIGIN="<local-or-deployment-origin>"
TRUST_PROXY_HEADERS="false"
ENABLE_HSTS="false"
ENABLE_HTTPS_UPGRADE="false"
FIRST_RUN_BOOTSTRAP_TOKEN="<generate-locally-and-keep-environment-only>"
BROWSER_RESTORE_COPIED_QA_ROOT="<local-disposable-copy-root>"
NEXT_PUBLIC_PWA_BUILD_VERSION="<non-secret-build-label>"
NALANDA_RELEASE_ID="<non-secret-release-id>"
NALANDA_RELEASE_CHANNEL="<development-test-preview-staging-or-production>"
NALANDA_BUILD_ID="<non-secret-build-label>"
NALANDA_RELEASE_DATE="<iso-8601-release-date>"
SOURCE_DATE_EPOCH="<unix-seconds-from-reviewed-commit>"
NALANDA_MINIMUM_WEB_CLIENT="<minimum-supported-client-version>"
NALANDA_CLIENT_UPDATE_SEVERITY="<NONE-AVAILABLE-RECOMMENDED-REQUIRED-or-CRITICAL>"
NALANDA_RELEASE_STATE_ROOT="<absolute-private-release-state-root>"
NALANDA_MAINTENANCE_MODE="false"
LIVE_PROVIDERS_ENABLED="false"

# Staging deployment contract. These names are safe to commit; real values are not.
NALANDA_ENVIRONMENT="<DEVELOPMENT-TEST-PREVIEW-STAGING-or-PRODUCTION>"
NALANDA_DEPLOYMENT_ID="<non-secret-release-id>"
STAGING_DATA_DIR="<absolute-persistent-data-root>"
PRIVATE_STORAGE_ROOT="<absolute-private-storage-root>"
QPDF_EXECUTABLE_PATH="<absolute-reviewed-qpdf-path>"
QPDF_EXECUTABLE_SHA256="<pinned-64-character-lowercase-sha256>"
BACKUP_DIRECTORY="<absolute-private-backup-directory>"
FEE_REGISTER_OCR_STORAGE_DIR="<absolute-private-ocr-directory>"
CLOUD_BACKUP_LOCAL_FOLDER="<absolute-private-encrypted-backup-directory>"
CLOUD_BACKUP_TEMP_DIR="<absolute-private-temporary-directory>"
CLOUD_BACKUP_REHEARSAL_DIR="<absolute-private-restore-rehearsal-directory>"
NALANDA_TRUSTED_PROXY_MODE="<disabled-or-single-hop-sanitized>"
NALANDA_LOCAL_REHEARSAL="false"
PUBLIC_WEBSITE_URL="<local-or-deployment-origin>"
PUBLIC_WEBSITE_INDEXING_ENABLED="false"
NALANDA_STAGING_BANNER="true"

# Cross-environment collision checks use references only; never place real values
# from both environments in the same file outside an isolated validator rehearsal.
NALANDA_STAGING_DATABASE_URL="<absolute-staging-sqlite-file-url>"
NALANDA_PRODUCTION_DATABASE_URL="<absolute-production-sqlite-file-url>"
NALANDA_STAGING_STORAGE_ROOT="<absolute-staging-private-storage-root>"
NALANDA_PRODUCTION_STORAGE_ROOT="<absolute-production-private-storage-root>"

# Production execution remains fail-closed. These are documented names, not an
# authorization to set them. A separately governed release must supply both.
NALANDA_PRODUCTION_RELEASE_AUTHORIZED="false"
NALANDA_PRODUCTION_APPROVAL_ID="<separate-governed-approval-reference>"

# Optional local seed passwords. Set only in the private runtime environment.
SEED_DIRECTOR_PASSWORD="<local-only-placeholder>"
SEED_ADMIN_PASSWORD="<local-only-placeholder>"
SEED_ACCOUNTANT_PASSWORD="<local-only-placeholder>"
SEED_VIEWER_PASSWORD="<local-only-placeholder>"

# Local Super Admin recovery. Set only for an approved stopped-app operation.
# Passwords are entered through the hidden prompt and never belong here.
AUTH_RECOVERY_EXPECTED_DB_SHA256="<approved-64-character-sha256>"
AUTH_RECOVERY_ROLLBACK_PATH="<absolute-protected-byte-copy-path>"
AUTH_RECOVERY_ROLLBACK_SHA256="<approved-64-character-sha256>"

# AUTH-2B delivery is disabled by default. LOCAL_TEST_SINK is permitted only
# with an ignored copied database under the matching absolute tmp root.
AUTH2B_DELIVERY_ADAPTER="DISABLED"
AUTH2B_COPIED_DATABASE_ROOT="<absolute-ignored-copied-database-root>"
AUTH2B_LOCAL_DELIVERY_MAILBOX="<absolute-ignored-private-mailbox-json>"

# One-way messaging remains live-disabled until its separate supervised release gate.
WHATSAPP_MOCK_WEBHOOK_SECRET="<mock-only-placeholder>"
WHATSAPP_MOCK_VERIFY_TOKEN="<mock-only-placeholder>"
WHATSAPP_PHONE_HASH_PEPPER="<generate-locally>"
SMS_EMAIL_CONTACT_HASH_PEPPER="<generate-locally>"
SMS_EMAIL_MOCK_WEBHOOK_SECRET="<mock-only-placeholder>"
SMS_EMAIL_SMS_PROVIDER_ADAPTER="<mock-adapter-name>"
SMS_EMAIL_SMS_LIVE_ENABLED="false"
SMS_EMAIL_EMAIL_LIVE_ENABLED="false"
SMS_EMAIL_SUPERVISED_LIVE_ACTIVATION_ENABLED="false"

# Provider credentials are environment-only and intentionally absent from this template.
GMAIL_OAUTH_CLIENT_ID="<provider-console-placeholder>"
GMAIL_OAUTH_CLIENT_SECRET="<provider-console-placeholder>"
GMAIL_OAUTH_REFRESH_TOKEN="<provider-console-placeholder>"
GMAIL_SENDER_EMAIL="<non-real-example-sender>"
AI_ASSISTANT_AUDIT_HASH_PEPPER="<generate-locally>"
CLOUD_BACKUP_ENCRYPTION_KEY_V1="<base64-encoded-32-random-bytes>"
# Event Media public output is fail-closed. Keep false until leadership has
# approved the public route, privacy wording, consent basis, and operations.
EVENT_MEDIA_PUBLIC_GALLERY_ENABLED=false
EVENT_MEDIA_PRIVATE_STORAGE_ROOT=

# Parent Meetings software remains operationally unavailable until an explicit
# copied/synthetic QA or later supervised activation sets this exact flag true.
PARENT_MEETINGS_V1_5=false
