{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nalandaps.invalid/schemas/onboarding/mapping-catalogue-1.0.json",
  "title": "Nalanda source-to-service mapping catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "domain", "sourceField", "sourceAliases", "sourceType", "sourceFormat", "proposedTargetService", "proposedTargetField", "transformation", "validation", "requirement", "authority", "conflictPolicy", "privacyClassification", "minimisationDecision", "migrationWave", "approvalOwner", "unsupportedReason"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,99}$" }, "domain": { "type": "string", "minLength": 1 }, "sourceField": { "type": "string", "minLength": 1 }, "sourceAliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "sourceType": { "type": "string" }, "sourceFormat": { "type": "string" }, "proposedTargetService": { "type": "string", "minLength": 1 }, "proposedTargetField": { "type": "string", "minLength": 1 }, "transformation": { "type": "string" }, "validation": { "type": "string" }, "requirement": { "enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"] }, "authority": { "type": "string" }, "conflictPolicy": { "type": "string" }, "privacyClassification": { "type": "string" }, "minimisationDecision": { "enum": ["MIGRATE_REQUIRED", "MIGRATE_OPTIONAL", "DERIVE_AFTER_IMPORT", "KEEP_AS_ARCHIVE_ONLY", "DO_NOT_MIGRATE", "LEGAL_OR_PRIVACY_DECISION_REQUIRED"] }, "migrationWave": { "pattern": "^(WAVE_[0-8]|NO_IMPORT)$" }, "approvalOwner": { "type": "string" }, "unsupportedReason": { "type": ["string", "null"] }
      }
    }
  }
}
